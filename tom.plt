set output 'tom_tr01.eps'
set terminal postscript eps color enhanced font "Helvetica,12"
set size ratio -1
set title "helicity density [Wb^2/m^3]" offset 20,-4
set xrange [0:100]
set yrange [0:100]
set zrange [0:100]
#unset border
#unset xtics
#unset ytics
#unset raxis
#unset rtics
set palette defined ( 0 "blue", 0.5 "white", 1 "red" )
set cbrange [-50:50]

plot "tom_tr01.out" matrix w image noti


